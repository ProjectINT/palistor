{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "index.ts",
    "store/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app-demo",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
