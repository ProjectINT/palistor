{
  "name": "palistor",
  "version": "0.1.0-cube.0",
  "description": "Declarative MVVM-style state framework for React — forms, lists & wizards, batteries included",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./store/store": {
      "types": "./dist/store/store/index.d.ts",
      "import": "./dist/store/store/index.js",
      "default": "./dist/store/store/index.js"
    },
    "./store/persist": {
      "types": "./dist/store/persist/index.d.ts",
      "import": "./dist/store/persist/index.js",
      "default": "./dist/store/persist/index.js"
    },
    "./react/useForm": {
      "types": "./dist/react/useForm.d.ts",
      "import": "./dist/react/useForm.js",
      "default": "./dist/react/useForm.js"
    },
    "./react/usePersist": {
      "types": "./dist/react/usePersist.d.ts",
      "import": "./dist/react/usePersist.js",
      "default": "./dist/react/usePersist.js"
    },
    "./react/useTranslator": {
      "types": "./dist/react/useTranslator.d.ts",
      "import": "./dist/react/useTranslator.js",
      "default": "./dist/react/useTranslator.js"
    },
    "./react/useNotifier": {
      "types": "./dist/react/useNotifier.d.ts",
      "import": "./dist/react/useNotifier.js",
      "default": "./dist/react/useNotifier.js"
    },
    "./cube": {
      "types": "./dist/cube/index.d.ts",
      "import": "./dist/cube/index.js",
      "default": "./dist/cube/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --project store",
    "test:cube": "vitest run --project cube",
    "typecheck:cube": "tsc -p cube/tsconfig.json",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org",
    "publish:github": "sh -c 'npm pkg set name=@projectint/palistor && npm publish --registry=https://npm.pkg.github.com \"$@\"; npm pkg set name=palistor' publish:github"
  },
  "keywords": [
    "mvvm",
    "state-management",
    "ai-friendly",
    "forms",
    "wizard",
    "react",
    "state",
    "form-state",
    "reactive"
  ],
  "author": "Yuri Palienko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectINT/palistor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
