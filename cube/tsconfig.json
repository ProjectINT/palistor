// Editor and `npm run typecheck:cube` view of cube/, including contract tests
// and benches. "@impl" resolves to the store entry: cube/index.ts re-exports
// the same public types, so the contract is typed once for both.
{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@impl": ["../index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Ported verbatim from store/store/store.test.ts, which no tsconfig ever
  // checked: with `config: x as any`, ConfigProxy<any> collapses to the flow
  // node type and `.label` fails. A public-types issue, not a contract one.
  "exclude": ["contract/sliceA/store.test.ts"]
}
