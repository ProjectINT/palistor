// Editor and `npm run typecheck:cube` view of cube/, including contract tests
// and benches. "@impl" resolves to the store entry: cube/index.ts re-exports
// the same public types, so the contract is typed once for both.
{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@impl": ["../index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Ported verbatim from store/store/store.test.ts, which no tsconfig ever
  // checked: with `config: x as any`, ConfigProxy<any> collapses to the flow
  // node type and `.label` fails. A public-types issue, not a contract one.
  // The sliceC files below hit the known TemplateConfig gap (a nested
  // defineList or a group inside a typed template does not type; the react
  // originals cast `as any`). Same category: public types, not the contract.
  "exclude": [
    "contract/sliceA/store.test.ts",
    "contract/sliceC/deleteListConsistency.test.ts",
    "contract/sliceC/entityListDirty.test.ts",
    "contract/sliceC/entityListGetValues.test.ts",
    "contract/sliceC/entityListMutations.test.ts",
    "contract/sliceC/entityListNested.react.test.tsx",
    "contract/sliceC/entityListNested.test.ts",
    "contract/sliceC/entityListResolve.test.ts",
    "contract/sliceC/listResolveError.react.test.tsx",
    "contract/sliceC/listResolveError.test.ts"
  ]
}
